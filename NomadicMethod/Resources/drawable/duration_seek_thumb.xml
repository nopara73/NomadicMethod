<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:width="28dp"
        android:height="28dp"
        android:gravity="center">
        <shape android:shape="oval">
            <solid android:color="@color/brand_graphite" />
            <stroke
                android:width="2dp"
                android:color="@color/surface" />
        </shape>
    </item>
    <item
        android:width="10dp"
        android:height="10dp"
        android:gravity="center">
        <shape android:shape="oval">
            <solid android:color="@color/brand_chartreuse" />
        </shape>
    </item>
</layer-list>
