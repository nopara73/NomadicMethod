<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowBackground">@drawable/screen_background</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/completion_bottom</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:colorAccent">@color/accent</item>
    </style>

    <style name="NomadicMethodEyebrowText" parent="@android:style/Widget.TextView">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.18</item>
        <item name="android:textColor">@color/accent_text</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="DurationStepButton" parent="@android:style/Widget.Material.Button">
        <item name="android:background">@drawable/quiet_button_background</item>
        <item name="android:elevation">1dp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:padding">0dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/accent_text</item>
        <item name="android:textSize">28sp</item>
    </style>

    <style name="DurationOptionLabel" parent="@android:style/Widget.TextView">
        <item name="android:autoSizeMaxTextSize">12sp</item>
        <item name="android:autoSizeMinTextSize">8sp</item>
        <item name="android:autoSizeStepGranularity">1sp</item>
        <item name="android:autoSizeTextType">uniform</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:gravity">center</item>
        <item name="android:importantForAccessibility">no</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">@color/secondary_text</item>
        <item name="android:textSize">10sp</item>
    </style>

    <style name="DurationModifierTile" parent="@android:style/Widget.Material.CompoundButton.CheckBox">
        <item name="android:background">@drawable/duration_modifier_background</item>
        <item name="android:elevation">1dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:padding">16dp</item>
    </style>

    <style name="NomadicMethodPrimaryButton" parent="@android:style/Widget.Material.Button">
        <item name="android:background">@drawable/primary_button_background</item>
        <item name="android:elevation">3dp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/primary_text</item>
        <item name="android:textSize">20sp</item>
    </style>

    <style name="NomadicMethodKeepButton" parent="@android:style/Widget.Material.ImageButton">
        <item name="android:background">@drawable/rest_button_background</item>
        <item name="android:elevation">3dp</item>
        <item name="android:minHeight">48dp</item>
    </style>

    <style name="NomadicMethodCompletionButton" parent="@android:style/Widget.Material.Button">
        <item name="android:background">@drawable/completion_button_background</item>
        <item name="android:elevation">3dp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/completion_bottom</item>
        <item name="android:textSize">20sp</item>
    </style>

    <style name="NomadicMethodQuietButton" parent="@android:style/Widget.Material.Button">
        <item name="android:background">@drawable/quiet_button_background</item>
        <item name="android:elevation">1dp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/accent_text</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="DurationRouteSegmentActive">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">10dp</item>
        <item name="android:layout_marginStart">1dp</item>
        <item name="android:layout_marginEnd">1dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@drawable/duration_segment_active</item>
        <item name="android:importantForAccessibility">no</item>
    </style>

    <style name="DurationRouteSegmentInactive">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">10dp</item>
        <item name="android:layout_marginStart">1dp</item>
        <item name="android:layout_marginEnd">1dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@drawable/duration_segment_inactive</item>
        <item name="android:importantForAccessibility">no</item>
    </style>
</resources>
