<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/duration_screen"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/screen_background">

    <LinearLayout
        android:id="@+id/duration_inset_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <ScrollView
            android:id="@+id/duration_scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:overScrollMode="never">

            <LinearLayout
                android:id="@+id/duration_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingStart="24dp"
                android:paddingTop="24dp"
                android:paddingEnd="24dp"
                android:paddingBottom="24dp">

                <LinearLayout
                    android:id="@+id/duration_identity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingBottom="16dp">

                    <ImageView
                        android:id="@+id/duration_app_icon"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:contentDescription="@string/app_name"
                        android:scaleType="fitCenter"
                        android:src="@mipmap/nomadic_method_appicon" />

                    <FrameLayout
                        android:id="@+id/duration_dial"
                        android:layout_width="250dp"
                        android:layout_height="250dp"
                        android:layout_marginTop="22dp"
                        android:background="@drawable/duration_dial_background"
                        android:elevation="8dp"
                        android:outlineProvider="background">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/duration_minutes_value"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:accessibilityLiveRegion="polite"
                                android:contentDescription="@string/duration_value_default_description"
                                android:fontFamily="sans-serif-medium"
                                android:gravity="center"
                                android:includeFontPadding="false"
                                android:maxLines="1"
                                android:text="@string/duration_minutes_default"
                                android:textColor="@color/brand_bone"
                                android:textSize="88sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="-6dp"
                                android:fontFamily="sans-serif-medium"
                                android:importantForAccessibility="no"
                                android:letterSpacing="0.18"
                                android:text="@string/duration_minutes_unit"
                                android:textColor="@color/brand_chartreuse"
                                android:textSize="13sp" />
                        </LinearLayout>

                        <ImageView
                            android:id="@+id/duration_lock_icon"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="bottom|center_horizontal"
                            android:layout_marginBottom="18dp"
                            android:contentDescription="@string/workout_duration_locked_description"
                            android:src="@drawable/ic_lock"
                            android:tint="@color/brand_chartreuse"
                            android:visibility="gone" />
                    </FrameLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/duration_controls"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/duration_step_row"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:layout_marginTop="28dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/duration_decrease_button"
                        style="@style/DurationStepButton"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:contentDescription="@string/duration_decrease_description"
                        android:foreground="@drawable/ic_minus"
                        android:foregroundGravity="center"
                        android:foregroundTint="@color/accent_text"
                        android:gravity="center" />

                    <SeekBar
                        android:id="@+id/duration_seek_bar"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_marginStart="10dp"
                        android:layout_marginEnd="10dp"
                        android:layout_weight="1"
                        android:contentDescription="@string/duration_seek_description_default"
                        android:max="9"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:progress="3"
                        android:progressDrawable="@drawable/duration_seek_track"
                        android:splitTrack="false"
                        android:thumb="@drawable/duration_seek_thumb" />

                    <Button
                        android:id="@+id/duration_increase_button"
                        style="@style/DurationStepButton"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:contentDescription="@string/duration_increase_description"
                        android:foreground="@drawable/ic_plus"
                        android:foregroundGravity="center"
                        android:foregroundTint="@color/accent_text"
                        android:gravity="center" />
                </LinearLayout>

                <FrameLayout
                    android:id="@+id/duration_option_labels"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="-8dp">

                    <TextView
                        style="@style/DurationOptionLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/duration_option_3" />

                    <TextView
                        style="@style/DurationOptionLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/duration_option_5" />

                    <TextView
                        style="@style/DurationOptionLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/duration_option_7" />

                    <TextView
                        style="@style/DurationOptionLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/duration_option_10" />

                    <TextView
                        style="@style/DurationOptionLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/duration_option_15" />

                    <TextView
                        style="@style/DurationOptionLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/duration_option_20" />

                    <TextView
                        style="@style/DurationOptionLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/duration_option_30" />

                    <TextView
                        style="@style/DurationOptionLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/duration_option_45" />

                    <TextView
                        style="@style/DurationOptionLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/duration_option_60" />

                    <TextView
                        style="@style/DurationOptionLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/duration_option_90" />
                </FrameLayout>

                <HorizontalScrollView
                    android:id="@+id/duration_modifier_scroller"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="32dp"
                    android:fillViewport="true"
                    android:overScrollMode="never"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/duration_modifier_groups"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:baselineAligned="false"
                        android:gravity="center"
                        android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/duration_context_modifier_group"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/duration_modifier_group_background"
                        android:baselineAligned="false"
                        android:elevation="1dp"
                        android:orientation="horizontal">

                        <CheckBox
                            android:id="@+id/upper_body_clothing_modifier_button"
                            style="@style/DurationModifierTile"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:layout_margin="5dp"
                            android:layout_gravity="center"
                            android:button="@null"
                            android:checked="true"
                            android:contentDescription="@string/upper_body_clothing_modifier_description"
                            android:drawableTint="@color/duration_modifier_icon_tint"
                            android:drawableTop="@drawable/ic_upper_body_clothing"
                            android:gravity="center"
                            android:text=""
                            android:tooltipText="@string/upper_body_clothing_enabled_feedback" />

                        <CheckBox
                            android:id="@+id/hard_floor_modifier_button"
                            style="@style/DurationModifierTile"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:layout_margin="5dp"
                            android:layout_gravity="center"
                            android:button="@null"
                            android:checked="true"
                            android:contentDescription="@string/hard_floor_modifier_description"
                            android:drawableTint="@color/duration_modifier_icon_tint"
                            android:drawableTop="@drawable/ic_hard_floor"
                            android:gravity="center"
                            android:text=""
                            android:tooltipText="@string/hard_floor_enabled_feedback" />

                        <CheckBox
                            android:id="@+id/insect_modifier_button"
                            style="@style/DurationModifierTile"
                            android:layout_width="64dp"
                            android:layout_height="64dp"
                            android:layout_margin="5dp"
                            android:layout_gravity="center"
                            android:button="@null"
                            android:checked="false"
                            android:contentDescription="@string/insect_modifier_description"
                            android:foreground="@drawable/ic_insect"
                            android:foregroundGravity="center"
                            android:foregroundTint="@color/duration_modifier_icon_tint"
                            android:text=""
                            android:tooltipText="@string/insect_mode_disabled_feedback" />

                        <CheckBox
                            android:id="@+id/silence_modifier_button"
                            style="@style/DurationModifierTile"
                            android:layout_width="64dp"
                            android:layout_height="64dp"
                            android:layout_margin="5dp"
                            android:layout_gravity="center"
                            android:button="@null"
                            android:checked="true"
                            android:contentDescription="@string/silence_modifier_description"
                            android:foreground="@drawable/ic_no_clap"
                            android:foregroundGravity="center"
                            android:text=""
                            android:tooltipText="@string/noisy_exercises_disabled_feedback" />

                        <CheckBox
                            android:id="@+id/shy_modifier_button"
                            style="@style/DurationModifierTile"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:layout_margin="5dp"
                            android:layout_gravity="center"
                            android:button="@null"
                            android:checked="false"
                            android:contentDescription="@string/shy_modifier_description"
                            android:drawableTint="@color/duration_modifier_icon_tint"
                            android:drawableTop="@drawable/ic_shy"
                            android:gravity="center"
                            android:text=""
                            android:tooltipText="@string/shy_mode_disabled_feedback" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/duration_intensity_modifier_group"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:background="@drawable/duration_modifier_group_background"
                        android:baselineAligned="false"
                        android:elevation="1dp"
                        android:orientation="horizontal">

                        <FrameLayout
                            android:id="@+id/light_workout_modifier_container"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:layout_margin="5dp"
                            android:layout_gravity="center">

                            <CheckBox
                                android:id="@+id/light_workout_modifier_button"
                                style="@style/DurationModifierTile"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:button="@null"
                                android:checked="false"
                                android:contentDescription="@string/light_workout_modifier_description"
                                android:drawableTint="@color/duration_modifier_icon_tint"
                                android:drawableTop="@drawable/ic_light_workout"
                                android:gravity="center"
                                android:text=""
                                android:tooltipText="@string/light_workout_disabled_feedback" />

                            <TextView
                                android:id="@+id/light_workout_countdown_badge"
                                android:layout_width="wrap_content"
                                android:minWidth="18dp"
                                android:paddingHorizontal="3dp"
                                android:layout_height="18dp"
                                android:layout_gravity="top|end"
                                android:background="@drawable/light_workout_countdown_badge"
                                android:elevation="4dp"
                                android:clickable="false"
                                android:focusable="false"
                                android:fontFamily="sans-serif-medium"
                                android:gravity="center"
                                android:importantForAccessibility="no"
                                android:text="18"
                                android:textColor="@color/brand_graphite"
                                android:textSize="11sp" />
                        </FrameLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/duration_equipment_modifier_group"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:background="@drawable/duration_modifier_group_background"
                        android:baselineAligned="false"
                        android:elevation="1dp"
                        android:orientation="horizontal">

                        <CheckBox
                            android:id="@+id/wall_modifier_button"
                            style="@style/DurationModifierTile"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:layout_margin="5dp"
                            android:layout_gravity="center"
                            android:button="@null"
                            android:checked="false"
                            android:contentDescription="@string/wall_modifier_description"
                            android:drawableTint="@color/duration_modifier_icon_tint"
                            android:drawableTop="@drawable/ic_wall_off"
                            android:gravity="center"
                            android:text=""
                            android:tooltipText="@string/wall_equipment_disabled_feedback" />

                        <CheckBox
                            android:id="@+id/mirror_modifier_button"
                            style="@style/DurationModifierTile"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:layout_margin="5dp"
                            android:layout_gravity="center"
                            android:button="@null"
                            android:checked="false"
                            android:contentDescription="@string/mirror_modifier_description"
                            android:drawableTint="@color/duration_modifier_icon_tint"
                            android:drawableTop="@drawable/ic_mirror"
                            android:gravity="center"
                            android:text=""
                            android:tooltipText="@string/mirror_equipment_disabled_feedback" />
                    </LinearLayout>
                    </LinearLayout>
                </HorizontalScrollView>

                <LinearLayout
                    android:id="@+id/duration_option_segments"
                    android:layout_width="match_parent"
                    android:layout_height="24dp"
                    android:baselineAligned="false"
                    android:focusable="false"
                    android:gravity="center_vertical"
                    android:importantForAccessibility="no"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <View android:id="@+id/duration_segment_01" style="@style/DurationRouteSegmentActive" />
                    <View android:id="@+id/duration_segment_02" style="@style/DurationRouteSegmentActive" />
                    <View android:id="@+id/duration_segment_03" style="@style/DurationRouteSegmentActive" />
                    <View android:id="@+id/duration_segment_04" style="@style/DurationRouteSegmentActive" />
                    <View android:id="@+id/duration_segment_05" style="@style/DurationRouteSegmentInactive" />
                    <View android:id="@+id/duration_segment_06" style="@style/DurationRouteSegmentInactive" />
                    <View android:id="@+id/duration_segment_07" style="@style/DurationRouteSegmentInactive" />
                    <View android:id="@+id/duration_segment_08" style="@style/DurationRouteSegmentInactive" />
                    <View android:id="@+id/duration_segment_09" style="@style/DurationRouteSegmentInactive" />
                    <View android:id="@+id/duration_segment_10" style="@style/DurationRouteSegmentInactive" />
                </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <FrameLayout
            android:id="@+id/duration_action_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/duration_action_background"
            android:paddingStart="24dp"
            android:paddingTop="12dp"
            android:paddingEnd="24dp"
            android:paddingBottom="16dp">

            <ImageButton
                android:id="@+id/end_session_button"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_gravity="start|center_vertical"
                android:background="@drawable/duration_modifier_background"
                android:contentDescription="@string/end_session_description"
                android:padding="14dp"
                android:src="@drawable/ic_end_session"
                android:tint="@color/primary_text"
                android:visibility="gone" />

            <Button
                android:id="@+id/begin_workout_button"
                style="@style/NomadicMethodPrimaryButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:contentDescription="@string/duration_start_default"
                android:gravity="center"
                android:minHeight="68dp"
                android:textSize="34sp" />

            <ImageView
                android:id="@+id/duration_action_icon"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_gravity="center"
                android:clickable="false"
                android:elevation="4dp"
                android:focusable="false"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_arrow_forward"
                android:tint="@color/primary_text" />
        </FrameLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/duration_modifier_feedback"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:accessibilityLiveRegion="polite"
        android:background="@drawable/duration_modifier_feedback_background"
        android:elevation="18dp"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:importantForAccessibility="yes"
        android:letterSpacing="0.04"
        android:maxLines="1"
        android:paddingStart="24dp"
        android:paddingTop="15dp"
        android:paddingEnd="24dp"
        android:paddingBottom="15dp"
        android:textColor="@color/brand_chartreuse"
        android:textSize="19sp"
        android:visibility="gone" />
</FrameLayout>
