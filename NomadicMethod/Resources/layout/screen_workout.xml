<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/workout_screen"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/screen_background"
    android:visibility="gone">

    <LinearLayout
        android:id="@+id/workout_phase_surface"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="false"
        android:focusable="false"
        android:importantForAccessibility="no"
        android:layoutDirection="ltr"
        android:orientation="horizontal"
        android:visibility="gone">

        <View
            android:id="@+id/workout_phase_left"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

        <View
            android:id="@+id/workout_phase_right"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/workout_inset_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="12dp"
        android:paddingEnd="20dp"
        android:paddingBottom="16dp">

        <LinearLayout
            android:id="@+id/workout_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/workout_progress_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:letterSpacing="0.08"
                    android:minHeight="36dp"
                    android:textColor="@color/secondary_text"
                    android:textSize="12sp" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />

                <FrameLayout
                    android:id="@+id/execution_signifier"
                    android:layout_width="wrap_content"
                    android:layout_height="52dp"
                    android:layout_marginStart="12dp"
                    android:gravity="center"
                    android:importantForAccessibility="no"
                    android:visibility="visible" />

                <ImageButton
                    android:id="@+id/workout_setup_button"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="6dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/change_workout_setup_description"
                    android:padding="8dp"
                    android:src="@drawable/ic_tune"
                    android:tint="@color/secondary_text"
                    android:tooltipText="@string/change_workout_setup_description" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/workout_progress_bar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="5dp"
                android:layout_marginTop="6dp"
                android:importantForAccessibility="no"
                android:max="30"
                android:progress="1"
                android:progressDrawable="@drawable/progress_track" />

            <TextView
                android:id="@+id/exercise_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:accessibilityHeading="true"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:gravity="start"
                android:lineSpacingExtra="1dp"
                android:longClickable="true"
                android:maxLines="4"
                android:textColor="@color/primary_text"
                android:textSize="23sp" />

        </LinearLayout>

        <FrameLayout
            android:id="@+id/exercise_media_area"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"
            android:layout_weight="1"
            android:gravity="center"
            android:minHeight="@dimen/workout_media_min_height">

            <FrameLayout
                android:id="@+id/exercise_media_card"
                android:layout_width="260dp"
                android:layout_height="260dp"
                android:layout_gravity="center"
                android:background="@drawable/media_card_background"
                android:clipToOutline="true"
                android:elevation="5dp"
                android:outlineProvider="background"
                android:padding="4dp">

                <VideoView
                    android:id="@+id/exercise_video"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@android:color/transparent"
                    android:importantForAccessibility="no" />

                <ImageView
                    android:id="@+id/hold_frame_image"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/media_background"
                    android:importantForAccessibility="no"
                    android:scaleType="fitCenter"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/exercise_mode_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|end"
                    android:layout_margin="10dp"
                    android:background="@drawable/hold_badge_background"
                    android:elevation="2dp"
                    android:fontFamily="sans-serif-medium"
                    android:importantForAccessibility="no"
                    android:letterSpacing="0.12"
                    android:paddingStart="10dp"
                    android:paddingTop="5dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="5dp"
                    android:text="@string/hold_badge"
                    android:textColor="@color/rest_text"
                    android:textSize="11sp"
                    android:visibility="gone" />

                <View
                    android:id="@+id/media_scrim"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/media_background" />

                <ProgressBar
                    android:id="@+id/media_loading_indicator"
                    style="?android:attr/progressBarStyleLarge"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:indeterminate="true"
                    android:indeterminateTint="@color/brand_graphite" />

                <LinearLayout
                    android:id="@+id/media_error_panel"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/media_background"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="@string/media_error"
                        android:textColor="@color/primary_text"
                        android:textSize="16sp" />

                    <Button
                        android:id="@+id/media_retry_button"
                        style="@style/NomadicMethodQuietButton"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:layout_marginTop="12dp"
                        android:text="@string/media_retry" />
                </LinearLayout>
            </FrameLayout>
        </FrameLayout>

        <FrameLayout
            android:id="@+id/workout_action_host"
            android:layout_width="match_parent"
            android:layout_height="@dimen/workout_action_height">

            <LinearLayout
                android:id="@+id/ready_panel"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/phase_ready_background"
                android:gravity="center"
                android:minHeight="@dimen/ready_panel_min_height"
                android:orientation="vertical"
                android:padding="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <ImageButton
                        android:id="@+id/shuffle_button"
                        android:layout_width="68dp"
                        android:layout_height="68dp"
                        android:background="@drawable/ready_secondary_button_background"
                        android:contentDescription="@string/shuffle_exercise_description"
                        android:elevation="2dp"
                        android:padding="20dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_shuffle" />

                    <ImageButton
                        android:id="@+id/start_button"
                        android:layout_width="0dp"
                        android:layout_height="68dp"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:background="@drawable/primary_button_background"
                        android:contentDescription="@string/start"
                        android:elevation="3dp"
                        android:padding="18dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_phase_active"
                        android:tint="@color/primary_text" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/countdown_panel"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@android:color/transparent"
                android:gravity="center"
                android:minHeight="@dimen/move_panel_min_height"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingTop="8dp"
                android:paddingEnd="12dp"
                android:paddingBottom="8dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <ImageButton
                        android:id="@+id/repeat_action"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/phase_move_chip_background"
                        android:contentDescription="@string/repeat_exercise_description"
                        android:foreground="?android:attr/selectableItemBackgroundBorderless"
                        android:padding="12dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_repeat"
                        android:tint="@color/move_text" />

                    <ImageButton
                        android:id="@+id/playback_action"
                        android:layout_width="56dp"
                        android:layout_height="48dp"
                        android:layout_marginStart="12dp"
                        android:layout_marginEnd="12dp"
                        android:background="@drawable/phase_move_chip_background"
                        android:contentDescription="@string/pause_exercise_description"
                        android:foreground="?android:attr/selectableItemBackgroundBorderless"
                        android:padding="12dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_phase_pause"
                        android:tint="@color/move_text" />

                    <ImageButton
                        android:id="@+id/next_action"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/phase_move_chip_background"
                        android:contentDescription="@string/next_exercise_description"
                        android:foreground="?android:attr/selectableItemBackgroundBorderless"
                        android:padding="12dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_next"
                        android:tint="@color/move_text" />
                </LinearLayout>

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="60dp">

                    <TextView
                        android:id="@+id/countdown_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:text="@string/countdown_initial"
                        android:textColor="@color/move_text"
                        android:textSize="60sp" />
                </FrameLayout>

                <ProgressBar
                    android:id="@+id/countdown_progress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="5dp"
                    android:layout_marginTop="8dp"
                    android:importantForAccessibility="no"
                    android:max="45000"
                    android:progress="45000"
                    android:progressDrawable="@drawable/move_progress_track" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/rest_panel"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@android:color/transparent"
                android:gravity="center"
                android:minHeight="@dimen/rest_panel_min_height"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingTop="8dp"
                android:paddingEnd="12dp"
                android:paddingBottom="8dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageButton
                        android:id="@+id/rest_playback_action"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:background="@android:color/transparent"
                        android:contentDescription="@string/pause_rest_description"
                        android:foreground="?android:attr/selectableItemBackgroundBorderless"
                        android:padding="8dp"
                        android:scaleType="fitStart"
                        android:src="@drawable/ic_phase_pause"
                        android:tint="@color/rest_text" />

                    <TextView
                        android:id="@+id/rest_countdown_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:text="@string/rest_initial"
                        android:textColor="@color/rest_text"
                        android:textSize="40sp" />
                </LinearLayout>

                <ProgressBar
                    android:id="@+id/rest_progress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="5dp"
                    android:layout_marginTop="4dp"
                    android:importantForAccessibility="no"
                    android:max="15000"
                    android:progress="15000"
                    android:progressDrawable="@drawable/rest_progress_track" />

                <ImageButton
                    android:id="@+id/keep_button"
                    style="@style/NomadicMethodKeepButton"
                    android:layout_width="match_parent"
                    android:layout_height="68dp"
                    android:layout_marginTop="10dp"
                    android:contentDescription="@string/keep_exercise_description"
                    android:minHeight="60dp"
                    android:padding="8dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_love"
                    android:tint="@color/white" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
