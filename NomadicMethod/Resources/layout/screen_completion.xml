<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/congratulations_screen"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/congratulations_background"
    android:visibility="gone">

    <LinearLayout
        android:id="@+id/completion_inset_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <FrameLayout
            android:id="@+id/completion_hero"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <FrameLayout
                android:id="@+id/completion_halo"
                android:layout_width="280dp"
                android:layout_height="280dp"
                android:layout_gravity="center"
                android:background="@drawable/completion_halo_background"
                android:padding="46dp">

                <ImageView
                    android:id="@+id/completion_mark"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:accessibilityHeading="true"
                    android:background="@drawable/completion_check_background"
                    android:contentDescription="@string/workout_complete_description"
                    android:padding="34dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_completion_check"
                    android:tint="@color/completion_gold" />
            </FrameLayout>
        </FrameLayout>

        <FrameLayout
            android:id="@+id/completion_action_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="24dp"
            android:paddingTop="12dp"
            android:paddingEnd="24dp"
            android:paddingBottom="16dp">

            <Button
                android:id="@+id/done_button"
                style="@style/NomadicMethodCompletionButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="68dp"
                android:maxLines="2"
                android:text="@string/done" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
