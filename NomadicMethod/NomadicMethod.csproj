<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>24</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationId>com.local.nomadicmethod</ApplicationId>
    <ApplicationVersion>185</ApplicationVersion>
    <ApplicationDisplayVersion>3.61</ApplicationDisplayVersion>
    <!-- Device deployments must remain launchable without transient fast-deploy files. -->
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
    <!--
      Enables trim analyzers and full trimming during Release mode.
      To learn more, see: https://learn.microsoft.com/dotnet/core/deploying/trimming/trimming-options#trimming-granularity
    -->
    <TrimMode>full</TrimMode>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\workout_durations.json" LogicalName="NomadicMethod.WorkoutDurations" />
    <EmbeddedResource Include="Assets\catalog_protocol_history.json" LogicalName="NomadicMethod.WorkoutProtocolHistory" />
    <!-- GIFs are reproducible generator inputs, not runtime assets. -->
    <AndroidAsset Remove="Assets\exercise_gifs\**\*.gif" />
  </ItemGroup>
</Project>
