<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>24</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationId>com.local.nomadicmethod</ApplicationId>
    <ApplicationVersion>189</ApplicationVersion>
    <ApplicationDisplayVersion>3.65</ApplicationDisplayVersion>
    <NomadicDebuggable>false</NomadicDebuggable>
    <!-- Device deployments must remain launchable without transient fast-deploy files. -->
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
    <!--
      Enables trim analyzers and full trimming during Release mode.
      To learn more, see: https://learn.microsoft.com/dotnet/core/deploying/trimming/trimming-options#trimming-granularity
    -->
    <TrimMode>full</TrimMode>
  </PropertyGroup>

  <!-- Physical-phone Debug deployments must use optimized JIT execution.
       The interpreter makes long-workout planning visibly stall. The package
       remains an Android-debuggable Debug package with run-as access. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <Optimize>true</Optimize>
    <AndroidUseInterpreter>false</AndroidUseInterpreter>
    <UseInterpreter>false</UseInterpreter>
    <AndroidUseDebugRuntime>true</AndroidUseDebugRuntime>
    <NomadicDebuggable>true</NomadicDebuggable>
  </PropertyGroup>

  <PropertyGroup>
    <AndroidManifestPlaceholders>nomadicDebuggable=$(NomadicDebuggable)</AndroidManifestPlaceholders>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\workout_durations.json" LogicalName="NomadicMethod.WorkoutDurations" />
    <EmbeddedResource Include="Assets\catalog_protocol_history.json" LogicalName="NomadicMethod.WorkoutProtocolHistory" />
    <!-- GIFs are reproducible generator inputs, not runtime assets. -->
    <AndroidAsset Remove="Assets\exercise_gifs\**\*.gif" />
  </ItemGroup>
</Project>
