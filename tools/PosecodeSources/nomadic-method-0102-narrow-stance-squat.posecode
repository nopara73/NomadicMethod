posecode exercise "Narrow-Stance Squat"
  rig humanoid
  pose start = standing:
    hips: adduct 6

  step "Narrow squat" 1.4s settle:
    hips: flex 75
    knees: flex 90
    ankles: dorsiflex 12
    pelvis: hinge 22
    shoulders: flex 50
    ground-lock: feet
    cue "Bend both hips and knees into a squat while the feet stay close together"

  step "Stand" 1.2s drive:
    hips: flex 0
    knees: flex 0
    ankles: dorsiflex 0
    pelvis: hinge 0
    shoulders: flex 0
    ground-lock: feet
    cue "Straighten both legs and return to the narrow upright stance"

  repeat 1
