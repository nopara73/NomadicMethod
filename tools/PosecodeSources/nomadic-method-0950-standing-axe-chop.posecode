posecode exercise "Standing Axe Chop"
  rig humanoid
  pose start = standing:
    shoulders: flex 170
    elbows: flex 8

  step "Chop down" 1s settle:
    hips: flex 45
    knees: flex 55
    pelvis: hinge 25
    spine: flex 10
    shoulders: flex 35
    elbows: flex 8
    ground-lock: feet
    cue "Squat and hinge while sweeping both arms down from overhead"

  step "Rise overhead" 1s settle:
    hips: flex 0
    knees: flex 0
    pelvis: hinge 0
    spine: flex 0
    shoulders: flex 170
    elbows: flex 8
    ground-lock: feet
    cue "Stand tall and return both hands overhead"

  repeat 1
