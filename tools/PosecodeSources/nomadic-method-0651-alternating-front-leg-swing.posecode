posecode exercise "Alternating Front Leg Swing"
  rig humanoid
  pose start = standing

  step "Swing left forward" 0.7s flow:
    hip_left: flex 65
    knee_left: flex 5
    pin: foot_right floor
    cue "Swing the nearly straight left leg forward"

  step "Reset left" 0.6s flow:
    hip_left: flex 0
    knee_left: flex 0
    ground-lock: feet
    cue "Return the left leg to neutral"

  step "Swing right forward" 0.7s flow:
    hip_right: flex 65
    knee_right: flex 5
    pin: foot_left floor
    cue "Swing the nearly straight right leg forward"

  step "Reset right" 0.6s settle:
    hip_right: flex 0
    knee_right: flex 0
    ground-lock: feet
    cue "Return the right leg to neutral"

  repeat 1
