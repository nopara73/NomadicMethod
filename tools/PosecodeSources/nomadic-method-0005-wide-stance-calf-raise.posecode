posecode exercise "Wide-Stance Calf Raise"
  rig humanoid
  pose start = standing:
    hips: abduct 18

  step "Raise both heels" 1.1s settle:
    ankles: plantarflex 34
    ground-lock: feet
    cue "Raise both heels together while the wide stance stays fixed"

  step "Lower both heels" 1.2s settle:
    ankles: plantarflex 0
    ground-lock: feet
    cue "Lower both heels together to the floor"

  repeat 1
