posecode exercise "Standing Chest Fly"
  rig humanoid
  pose start = standing

  step "Open fly" 0.9s settle:
    shoulders: flex 10
    shoulders: abduct 82
    elbows: flex 20
    ground-lock: feet
    cue "Open both softly bent arms wide at shoulder height"

  step "Close fly" 1s settle:
    shoulders: flex 85
    shoulders: adduct 12
    elbows: flex 20
    ground-lock: feet
    cue "Arc both softly bent arms forward together until the hands meet before the sternum"

  step "Hold closed" 0.25s linear:
    shoulders: flex 85
    shoulders: adduct 12
    elbows: flex 20
    ground-lock: feet
    cue "Briefly hold both arms together in front of the sternum"

  step "Reopen" 1s settle:
    shoulders: flex 10
    shoulders: abduct 82
    elbows: flex 20
    ground-lock: feet
    cue "Open both arms along the same chest-fly arc"

  step "Reset" 0.7s settle:
    shoulders: hold neutral
    elbows: hold neutral
    ground-lock: feet
    cue "Lower both arms to neutral at the sides"

  repeat 1
