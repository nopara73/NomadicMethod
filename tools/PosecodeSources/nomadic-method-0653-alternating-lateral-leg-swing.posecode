posecode exercise "Alternating Lateral Leg Swing"
  rig humanoid
  pose start = standing

  step "Swing left outward" 0.7s flow:
    hip_left: abduct 42
    knee_left: flex 5
    pin: foot_right floor
    cue "Swing the nearly straight left leg out to the side"

  step "Reset left" 0.6s flow:
    hip_left: abduct 0
    knee_left: flex 0
    ground-lock: feet
    cue "Return the left leg to neutral"

  step "Swing right outward" 0.7s flow:
    hip_right: abduct 42
    knee_right: flex 5
    pin: foot_left floor
    cue "Swing the nearly straight right leg out to the side"

  step "Reset right" 0.6s settle:
    hip_right: abduct 0
    knee_right: flex 0
    ground-lock: feet
    cue "Return the right leg to neutral"

  repeat 1
